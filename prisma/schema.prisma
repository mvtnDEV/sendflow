generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum UserRole {
  SUPER_ADMIN
  STORE_ADMIN
  VIEWER
  DRIVER
}
enum Platform {
  SHOPIFY
  MERCADOLIBRE
  WOOCOMMERCE
  JUMPSELLER
  MANUAL
}
enum Operator {
  NOW
  FRET
  MOOVEX
}
enum OrderStatus {
  PENDING
  RECEIVED
  DISPATCHED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  INCIDENT
  CANCELLED
}
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  password     String
  role         UserRole  @default(STORE_ADMIN)
  storeId      String?
  pin          String?
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  lastLoginIp  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  store        Store?       @relation(fields: [storeId], references: [id])
  auditLogs    AuditLog[]
  orderEvents  OrderEvent[]
  @@index([email])
  @@map("users")
}
model Store {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  email              String?
  phone              String?
  rut                String?
  reportEmail        String?
  encargado          String?
  addressRetiro      String?
  puntoRetiroFret    String?
  tarifaUrbana       Decimal? @db.Decimal(10,2)
  tarifaExtraUrbana  Decimal? @db.Decimal(10,2)
  tarifaRural        Decimal? @db.Decimal(10,2)
  tarifaRetiro       Decimal? @db.Decimal(10,2)
  fechaTarifa        String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  users              User[]
  integrations       StoreIntegration[]
  orders             Order[]
  apiKeys            ApiKey[]
  @@map("stores")
}
model StoreIntegration {
  id              String    @id @default(cuid())
  storeId         String
  platform        Platform
  externalStoreId String?
  apiKeyEnc       String
  webhookSecret   String?
  isActive        Boolean   @default(true)
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders   Order[]
  syncLogs SyncLog[]
  @@unique([storeId, platform])
  @@map("store_integrations")
}
model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  storeId         String
  integrationId   String?
  externalId      String?
  sourceId        String?
  subStoreName    String?
  platform        Platform    @default(MANUAL)
  customerName    String
  customerPhone   String?
  customerEmail   String?
  addressStreet   String
  addressComuna   String
  addressRegion   String
  addressNotes    String?
  status          OrderStatus @default(PENDING)
  bultos          Int         @default(1)
  weightKg        Decimal?    @db.Decimal(6,2)
  qrCode          String      @unique
  labelUrl        String?
  evidencePhoto1  String?
  evidencePhoto2  String?
  evidenceNote    String?
  evidenceTakenAt DateTime?
  evidenceTakenBy String?
  receptorName    String?
  receptorRut     String?
  incidentReason  String?
  receivedAt      DateTime?
  inTransitAt     DateTime?
  deliveredAt     DateTime?
  dataRetentionDate   DateTime?
  anonymizedAt        DateTime?
  rawPayload          Json?
  pendingNowEvidence  Json?
  pendingNowCheckedAt DateTime?
  mlShippedAt         DateTime?
  // Quien mueve el pedido. Define que tarifa de COSTO se le aplica.
  operator            Operator?
  // Si el pedido incluye retiro en origen. Antes era solo un checkbox en
  // estado de React (retiroMap) que se perdia al recargar, asi que el retiro
  // nunca se llegaba a facturar.
  conRetiro           Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  store       Store             @relation(fields: [storeId], references: [id])
  integration StoreIntegration? @relation(fields: [integrationId], references: [id])
  events      OrderEvent[]
  @@index([storeId, status])
  @@index([qrCode])
  @@index([externalId, integrationId])
  @@index([sourceId])
  @@index([dataRetentionDate])
  @@index([storeId, createdAt(sort: Desc)], map: "orders_storeId_createdAt_idx")
  @@index([createdAt(sort: Desc)], map: "orders_createdAt_idx")
  @@index([operator, createdAt])
  @@map("orders")
}
model OrderEvent {
  id              String      @id @default(cuid())
  orderId         String
  status          OrderStatus
  note            String?
  createdBy       String?
  createdByUserId String?
  ipAddress       String?
  createdAt       DateTime    @default(now())
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?  @relation(fields: [createdByUserId], references: [id])
  @@index([orderId])
  @@map("order_events")
}
model SyncLog {
  id             String   @id @default(cuid())
  integrationId  String
  ordersImported Int      @default(0)
  errors         Int      @default(0)
  errorDetails   String?
  createdAt      DateTime @default(now())
  integration StoreIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  @@map("sync_logs")
}
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
model DataDeletionRequest {
  id             String    @id @default(cuid())
  requesterName  String
  requesterEmail String
  orderId        String?
  reason         String?
  status         String    @default("PENDING")
  requestedAt    DateTime  @default(now())
  processedAt    DateTime?
  processedBy    String?
  @@index([status])
  @@map("data_deletion_requests")
}
model ApiKey {
  id            String    @id @default(cuid())
  name          String
  key           String    @unique
  storeId       String?
  webhookUrl    String?
  webhookSecret String?
  isActive      Boolean   @default(true)
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  @@index([key])
  @@map("api_keys")
}
/// Tabla creada con SQL a mano, NO desde este schema. Forma verificada contra
/// la base de producción el 2026-08-30 (information_schema.columns):
///   id integer (autoincremental) · created_at timestamp with time zone.
/// Los tres detalles importan: sin @default(autoincrement()) Prisma manda un
/// cuid a una columna entera, sin @map no encuentra la columna, y sin
/// @db.Timestamptz el tipo no calza. Cualquiera de los tres tumba el login.
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}
/// DEPRECADO — ya no lo usa nadie: el rate limit de /api/v1 pasó a RateLimitHit.
/// Se deja declarado a propósito para que un `db push` no borre la tabla.
/// Forma verificada contra producción el 2026-08-30: id integer autoincremental,
/// key text, created_at timestamp with time zone. El modelo anterior declaraba
/// `apiKeyId`, columna que esta tabla nunca tuvo.
model ApiRateLimit {
  id        Int      @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@index([key, createdAt])
  @@map("api_rate_limits")
}
model WebhookEvent {
  id           String   @id @default(cuid())
  apiKeyId     String
  orderId      String
  event        String
  url          String
  payload      Json
  statusCode   Int?
  responseBody String?
  success      Boolean  @default(false)
  attempt      Int      @default(1)
  errorMessage String?
  createdAt    DateTime @default(now())
  @@index([orderId])
  @@index([apiKeyId, createdAt])
  @@index([success, createdAt])
  @@map("webhook_events")
}
model RateLimitHit {
  id        String   @id @default(cuid())
  bucket    String
  createdAt DateTime @default(now())
  @@index([bucket, createdAt])
  @@map("rate_limit_hits")
}
enum AlertType {
  FLEX_CANCELLED
  STUCK_IN_TRANSIT
  NOT_SENT_TO_FRET
  FRET_NOT_PICKED_UP
}
enum AlertStatus {
  ACTIVE
  RESOLVED
}
model Alert {
  id           String      @id @default(cuid())
  type         AlertType
  status       AlertStatus @default(ACTIVE)
  dedupeKey    String      @unique
  orderId      String?
  orderNumber  String?
  storeId      String?
  title        String
  detail       String?
  metadata     Json?
  firstSeenAt  DateTime    @default(now())
  lastSeenAt   DateTime    @default(now())
  resolvedAt   DateTime?
  resolvedBy   String?
  resolvedNote String?
  @@index([status, type])
  @@index([storeId, status])
  @@map("alerts")
}
