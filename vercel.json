{
  "crons": [
    {
      "path": "/api/retention-cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/check-ml-pending",
      "schedule": "*/3 * * * *"
    },
    {
      "path": "/api/cron/check-ml-shipped",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/alerts",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/retry-fret",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/refresh-ml-tokens",
      "schedule": "0 */4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PATCH, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Authorization, Content-Type"
        }
      ]
    }
  ]
}
