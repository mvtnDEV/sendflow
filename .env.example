# ─────────────────────────────────────────────────────────────────────────────
# SendFlow — Variables de entorno
# Copia este archivo como .env y completa los valores
# NUNCA subas .env a Git
# ─────────────────────────────────────────────────────────────────────────────

# ─── Base de datos (Supabase) ─────────────────────────────────────────────────
# Project Settings → Database → Connection String → URI
# La primera usa pgBouncer (para producción), la segunda es directa (para migraciones)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ─── Supabase API ─────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# La URL debe ser la URL real de tu deployment en Vercel (sin barra final)
NEXTAUTH_URL="https://tu-app.vercel.app"
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# ─── Cifrado AES-256 para credenciales de integraciones ──────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DEBE ser exactamente 64 caracteres hexadecimales
ENCRYPTION_KEY=""

# ─── URL base de la aplicación ────────────────────────────────────────────────
# Misma que NEXTAUTH_URL (se usa para generar links de tracking, QR, etc.)
APP_URL="https://tu-app.vercel.app"

# ─── Cron jobs (Vercel Cron) ──────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
CRON_SECRET=""

# ─── Mercado Libre OAuth ──────────────────────────────────────────────────────
# Solo necesario si usas ML Flex
# Crear app en: https://developers.mercadolibre.com
ML_CLIENT_ID=""
ML_CLIENT_SECRET=""

# ─── Primer Super Admin (usado solo en npm run db:seed) ──────────────────────
# Si no se definen, usa los valores por defecto del seed
FIRST_ADMIN_EMAIL="admin@tuempresa.cl"
FIRST_ADMIN_PASSWORD="CambiameAlPrimerLogin2025!"
FIRST_ADMIN_NAME="Administrador"
